# Builds the feed image from Dockerfile.kernel.dist (multi-stage, slim runtime).
# CI uses Dockerfile.kernel.dist --target feed directly.
#
# Local equivalent:
#   docker build -f Dockerfile.kernel.dist --target feed -t swarm-feed .
#
# syntax=docker/dockerfile:1
FROM scratch
LABEL org.opencontainers.image.description="Use: docker build -f Dockerfile.kernel.dist --target feed ."
