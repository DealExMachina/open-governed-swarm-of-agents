# Standalone feed image: code copied into the image (no host bind mount).
# Built by CI and pushed to GHCR. For dev with live reload, use Dockerfile.feed + compose volumes.
FROM node:24-alpine

RUN apk add --no-cache curl build-base musl-dev \
  && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER=gcc
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_MUSL_LINKER=gcc

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./
COPY governance.yaml finality.yaml evidence_schemas.yaml propagation.yaml ./
COPY src ./src
COPY sgrs-core ./sgrs-core
# Studio + observability HTML required by feed asset loader (src/feed/assets.ts).
COPY public ./public

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate \
  && pnpm install --frozen-lockfile \
  && cd sgrs-core && pnpm install --frozen-lockfile \
  && pnpm exec napi build --release --platform

# Scenario manifests + corpora read at runtime by the feed's scenario loaders:
#   - src/baselines/scenario/ma-scenario.ts loads docs/benchmarks/manifests/*.yaml at boot
#   - src/studio/corpora.ts reads demo/scenario/* for Studio "load scenario"
# Placed after the build so changing these assets does not invalidate the Rust build cache.
COPY docs/benchmarks/manifests ./docs/benchmarks/manifests
COPY demo/scenario ./demo/scenario

EXPOSE 3002
ENV FEED_PORT=3002

CMD ["pnpm", "run", "feed"]
