          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "swarm_convergence_trajectory_quality{scope_id=~\"$scope_id\"}",
          "legendFormat": "{{scope_id}}",
          "refId": "A"
