{
  "annotations": {
    "list": [
      {
        "name": "Run activity",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "semi-dark-blue",
        "expr": "sum(increase(swarm_progress_activations_total[1m])) > 0",
        "titleFormat": "Run activity",
        "step": "60s"
      },
      {
        "name": "Agent errors",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "sum(increase(swarm_agent_error_count_total[1m])) > 0",
        "titleFormat": "Agent errors",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Swarm dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "swarm-suite"
      ],
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "apps",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "title": "Run Liveness  (is the swarm processing right now?)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Active Scopes (5m)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "count(sum by (scope_id) (rate(swarm_agent_latency_ms_milliseconds_count{scope_id=~\"$scope_id\"}[5m])) > 0)",
          "refId": "A"
        }
      ],
      "description": "Scopes with agent activity in the last 5m. 0 = swarm idle (frozen gauges above are stale)."
    },
    {
      "title": "Activations / min (5m)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.01
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(swarm_agent_latency_ms_milliseconds_count{scope_id=~\"$scope_id\"}[5m])) * 60",
          "refId": "A"
        }
      ],
      "description": "Agent activations per minute. Live heartbeat of run processing."
    },
    {
      "title": "Job Bus \u0394 (msgs / 5m)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(delta(jetstream_stream_last_seq[5m]))",
          "refId": "A"
        }
      ],
      "description": "New JetStream messages published in the last 5m. The honest 'work is flowing' signal (idle heartbeat does NOT advance stream sequence)."
    },
    {
      "title": "Run Activity \u2014 activations/min by scope",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (scope_id) (rate(swarm_agent_latency_ms_milliseconds_count{scope_id=~\"$scope_id\"}[5m])) * 60",
          "legendFormat": "{{scope_id}}",
          "refId": "A"
        }
      ],
      "description": "Per-scope activation rate. Flat line at zero = that scope is idle/converged, not processing.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "title": "Billing Currency  (deltas = value produced, tokens = metered cost)",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "title": "Total Deltas (currency)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_deltas_extracted_total{scope_id=~\"$scope_id\"})",
          "refId": "A"
        }
      ],
      "description": "Cumulative material evidence deltas produced. The billable unit of value."
    },
    {
      "title": "Delta Production Rate (deltas/min by scope)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 4,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (scope_id) (rate(swarm_deltas_extracted_total{scope_id=~\"$scope_id\"}[5m])) * 60",
          "legendFormat": "{{scope_id}}",
          "refId": "A"
        }
      ],
      "description": "Rate of value production per scope. This is currency flow.",
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "title": "Deltas by Channel",
      "type": "piechart",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 14,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right"
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (channel) (swarm_deltas_extracted_total{scope_id=~\"$scope_id\"})",
          "legendFormat": "{{channel}}",
          "refId": "A"
        }
      ],
      "description": "support vs refutation deltas."
    },
    {
      "title": "Total Tokens (metered)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_llm_tokens_total{scope_id=~\"$scope_id\"})",
          "refId": "A"
        }
      ],
      "description": "Cumulative LLM tokens consumed (metered cost when a model is used)."
    },
    {
      "title": "Tokens / Delta",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 21,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2000
              },
              {
                "color": "red",
                "value": 8000
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_llm_tokens_total{scope_id=~\"$scope_id\"}) / clamp_min(sum(swarm_deltas_extracted_total{scope_id=~\"$scope_id\"}), 1)",
          "refId": "A"
        }
      ],
      "description": "Token cost per unit of value produced. Lower is more efficient."
    },
    {
      "title": "Scope Convergence",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "title": "Active Governance Mode",
      "description": "Current governance mode per scope (MASTER / MITL / YOLO). Populates while governance is active.",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "MASTER",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "MITL",
                  "color": "orange"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "3": {
                  "text": "YOLO",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "swarm_governance_mode_active{mode=\"MASTER\",scope_id=~\"$scope_id\"} * 1 + swarm_governance_mode_active{mode=\"MITL\",scope_id=~\"$scope_id\"} * 2 + swarm_governance_mode_active{mode=\"YOLO\",scope_id=~\"$scope_id\"} * 3",
          "legendFormat": "{{scope_id}}",
          "refId": "A",
          "instant": true
        }
      ]
    },
