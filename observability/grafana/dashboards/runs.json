    {
      "title": "Agent Activation Wall Time by Role (avg)",
      "description": "Mean wall-clock time per agent activation. This is the run cost driver.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
