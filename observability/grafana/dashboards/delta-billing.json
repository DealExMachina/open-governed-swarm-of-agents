{
  "annotations": {
    "list": [
      {
        "name": "Billable delta mints",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "green",
        "expr": "sum(increase(swarm_billable_deltas_total[1m])) > 0",
        "titleFormat": "Billable deltas minted",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Swarm dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "swarm-suite"
      ],
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "apps",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "title": "Billing Summary  (select tenant)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Prepaid Plan (tokens)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_billing_prepaid_tokens{tenant=~\"$tenant\"})",
          "refId": "A"
        }
      ],
      "description": "Prepaid delta-token allowance for the selected tenant's plan."
    },
    {
      "title": "Tokens Consumed",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "unit": "short",
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_billing_delta_tokens_consumed{tenant=~\"$tenant\"})",
          "refId": "A"
        }
      ],
      "description": "Prepaid delta-tokens burned down this period."
    },
    {
      "title": "Balance Remaining",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_billing_delta_token_balance{tenant=~\"$tenant\"})",
          "refId": "A"
        }
      ],
      "description": "Remaining prepaid balance. 0 (red) means the tenant is now in overage."
    },
    {
      "title": "Overage Tokens",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_billing_overage_tokens{tenant=~\"$tenant\"})",
          "refId": "A"
        }
      ],
      "description": "Delta-tokens billed as overage (beyond prepaid). Red when > 0 = exploding subscription."
    },
    {
      "title": "Projected Overage Spend",
      "type": "stat",
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swarm_billing_overage_cents{tenant=~\"$tenant\"}) / 100",
          "refId": "A"
        }
      ],
      "description": "Overage cost in USD (overage cents / 100) at the plan's per-token rate."
    },
    {
      "title": "Prepaid Burn-down",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.75 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "clamp_max(sum(swarm:prepaid_burndown:by_tenant{tenant=~\"$tenant\"}), 1)",
          "refId": "A"
        }
      ],
      "description": "Fraction of prepaid plan consumed. 100% = plan exhausted, overage begins."
    },
    {
      "title": "Currency Flow & Balance",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false
    },
    {
      "title": "Billable Deltas / sec (5m) by tenant",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "swarm:billable_deltas:rate5m:by_tenant{tenant=~\"$tenant\"}",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "description": "Rate of net-new billable delta minting (the currency flow) per tenant."
    },
    {
      "title": "Prepaid Balance over time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "min"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (tenant) (swarm_billing_delta_token_balance{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} balance",
          "refId": "A"
        },
        {
          "expr": "sum by (tenant) (swarm_billing_overage_tokens{tenant=~\"$tenant\"})",
          "legendFormat": "{{tenant}} overage",
          "refId": "B"
        }
      ],
      "description": "Prepaid balance burning down to zero, then overage accumulating."
    },
    {
      "title": "Per-Scope Detail",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false
    },
    {
      "title": "Billable Deltas per Scope",
      "type": "table",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "filterable": true }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "billable deltas", "desc": true }]
      },
      "targets": [
        {
          "expr": "swarm_billing_billable_deltas{tenant=~\"$tenant\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "tenant_id": true, "job": true, "instance": true },
            "renameByName": { "tenant": "tenant", "scope_id": "scope", "Value": "billable deltas" }
          }
        }
      ],
      "description": "Cumulative net-new billable deltas produced by each scope for the selected tenant."
    },
    {
      "title": "Overage by Tenant",
      "type": "bargauge",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "sum by (tenant) (swarm_billing_overage_tokens)",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ],
      "description": "Overage tokens across all tenants. The exploding subscription stands out in red."
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "swarm",
    "billing",
    "deltas",
    "tenants",
    "swarm-suite"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(swarm_billing_prepaid_tokens, tenant)",
        "hide": 0,
        "includeAll": true,
        "label": "Tenant",
        "multi": true,
        "name": "tenant",
        "query": "label_values(swarm_billing_prepaid_tokens, tenant)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Delta Billing",
  "uid": "swarm-delta-billing",
  "version": 1,
  "refresh": "30s",
  "style": "dark"
}
