    {
      "title": "Connections used vs max",
      "type": "gauge",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.95
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "gnatsd_varz_connections / clamp_min(gnatsd_varz_max_connections, 1)",
          "legendFormat": "utilization",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JetStream Throughput (published msgs/s by stream)",
      "description": "Rate at which NEW messages are published to each stream (stream sequence advance). This is the honest 'real work is flowing' signal \u2014 unlike raw server msg rate, idle pull-consumer heartbeat does NOT advance stream sequence.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "mps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "showPoints": "never",
            "spanNulls": true,
            "pointSize": 5,
            "axisPlacement": "auto",
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (stream_name) (rate(jetstream_stream_last_seq[5m]))",
          "legendFormat": "{{stream_name}} published/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(gnatsd_varz_in_msgs[5m]))",
          "legendFormat": "server in msgs/s (incl. heartbeat+monitoring)",
          "refId": "B"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
