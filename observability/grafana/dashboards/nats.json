{
  "annotations": {
    "list": [
      {
        "name": "Run activity",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "semi-dark-blue",
        "expr": "sum(increase(swarm_progress_activations_total[1m])) > 0",
        "titleFormat": "Run activity",
        "step": "60s"
      },
      {
        "name": "Agent errors",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "expr": "sum(increase(swarm_agent_error_count_total[1m])) > 0",
        "titleFormat": "Agent errors",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Swarm dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "tags": [
        "swarm-suite"
      ],
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "apps",
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "title": "Server",
      "type": "row",
