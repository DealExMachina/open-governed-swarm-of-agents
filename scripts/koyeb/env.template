# Koyeb SGRS demo — copy to env.local and source before scripts.
# NEVER commit env.local.

# ── Koyeb ────────────────────────────────────────────────────────────────────
export KOYEB_APP_NAME="${KOYEB_APP_NAME:-sgrs-demo}"
export KOYEB_REGION="${KOYEB_REGION:-fra}"

# GHCR kernel images (pin digest in production)
export SWARM_FEED_IMAGE="${SWARM_FEED_IMAGE:-ghcr.io/dealexmachina/swarm-feed:latest}"
export SWARM_HATCHERY_IMAGE="${SWARM_HATCHERY_IMAGE:-ghcr.io/dealexmachina/swarm-hatchery:latest}"
export FACTS_WORKER_IMAGE="${FACTS_WORKER_IMAGE:-ghcr.io/dealexmachina/swarm-facts-worker:latest}"

# Product images (build from ../sgrs or your registry)
export SGRS_API_IMAGE="${SGRS_API_IMAGE:-ghcr.io/dealexmachina/sgrs-api:latest}"
export SGRS_STUDIO_IMAGE="${SGRS_STUDIO_IMAGE:-ghcr.io/dealexmachina/sgrs-studio:latest}"

# ── Shared secrets (set real values) ─────────────────────────────────────────
export DATABASE_URL=""                    # Koyeb Postgres (kernel + product may share or split)
export PRODUCT_DATABASE_URL=""            # optional separate product DB
export NATS_URL="nats://nats:4222"
export S3_ENDPOINT="http://minio:9000"
export S3_ACCESS_KEY=""
export S3_SECRET_KEY=""
export S3_BUCKET="swarm"
export OPENAI_API_KEY=""
export SWARM_API_TOKEN=""                 # feed ↔ product API
export KERNEL_CONTROL_PLANE_ADMIN_TOKEN=""

# Product auth
export CLERK_SECRET_KEY=""
export CLERK_WEBHOOK_SECRET=""
export NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
export API_KEY_PEPPER=""
export ENCRYPTION_KEY=""                  # base64 32-byte AES key

# Studio build/runtime
export NEXT_PUBLIC_BACKEND_API_URL=""     # public API URL, e.g. https://api.demo.example.com
export NEXT_PUBLIC_API_URL=""             # public Studio URL

# ── Optional domains ─────────────────────────────────────────────────────────
export KOYEB_API_DOMAIN=""                # e.g. api.demo.dealexmachina.com
export KOYEB_STUDIO_DOMAIN=""             # e.g. demo.dealexmachina.com
