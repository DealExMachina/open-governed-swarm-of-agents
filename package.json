{
  "name": "swarm-of-governed-agents",
  "version": "1.1.0",
  "description": "Governed multi-agent orchestration with formal convergence, bitemporal state, and auditable policy enforcement.",
  "license": "SEE LICENSE IN LICENSES.md",
  "private": true,
  "homepage": "https://github.com/DealExMachina/open-governed-swarm-of-agents",
  "repository": {
    "type": "git",
    "url": "https://github.com/DealExMachina/open-governed-swarm-of-agents.git"
  },
  "bugs": {
    "url": "https://github.com/DealExMachina/open-governed-swarm-of-agents/issues"
  },
  "keywords": [
    "multi-agent",
    "agent-orchestration",
    "governance",
    "convergence",
    "compliance",
    "auditability",
    "bitemporal",
    "langgraph",
    "rust",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "swarm": "node --loader ts-node/esm src/swarm.ts",
    "swarm:start": "bash scripts/ops/swarm-hatchery.sh",
    "swarm:stop": "bash scripts/ops/swarm-stop.sh",
    "build": "tsc",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc -p tsconfig.check.json --noEmit",
    "start": "node dist/swarm.js",
    "loadgen": "node dist/loadgen.js",
    "seed": "node --loader ts-node/esm scripts/ops/seed-context.ts",
    "seed:all": "node --loader ts-node/esm scripts/ops/seed-all.ts",
    "seed:hitl": "node --loader ts-node/esm scripts/demo/seed-hitl-scenario.ts",
    "seed:exp1": "node --loader ts-node/esm scripts/experiments/seed-exp1.ts",
    "seed:exp2": "node --loader ts-node/esm scripts/experiments/seed-exp2-graph.ts",
    "seed:exp3": "npx tsx scripts/experiments/seed-exp3-adversarial.ts",
    "simulate:mitl": "node --loader ts-node/esm scripts/ops/simulate-mitl-approve.ts",
    "exp:collect": "node --loader ts-node/esm scripts/experiments/collect-experiment-results.ts",
    "exp:drive": "node --loader ts-node/esm scripts/experiments/drive-experiment.ts",
    "seed:loadgen": "node --loader ts-node/esm scripts/experiments/loadgen-inject.ts",
    "exp:load": "bash scripts/experiments/run-load-experiment.sh",
    "seed:demo": "node --loader ts-node/esm scripts/demo/seed-demo.ts",
    "demo": "node --loader ts-node/esm demo/demo-server.ts",
    "demo:preflight": "bash scripts/demo/demo-preflight.sh",
    "seed:governance-e2e": "node --loader ts-node/esm scripts/ops/seed-governance-e2e.ts",
    "verify:governance-paths": "node --loader ts-node/esm scripts/checks/verify-governance-paths.ts",
    "check:model": "node --loader ts-node/esm scripts/checks/check-model-reachable.ts",
    "nli:verdicts": "python3 workers/facts-worker/tools/nli_verdicts.py",
    "nli:smoke": "pnpm exec tsx scripts/checks/nli-model-smoke.ts",
    "nli:train": "python3 workers/facts-worker/training/train_deberta_nli.py",
    "check:benchmark-manifests": "pnpm exec tsx scripts/checks/check-benchmark-manifests.ts",
    "benchmark:smoke-llm": "pnpm exec tsx scripts/benchmarks/benchmark-comparative.ts --preset=smoke-llm",
    "benchmark:smoke-llm:all": "pnpm exec tsx scripts/benchmarks/benchmark-smoke-llm-scenarios.ts",
    "check:services": "node --loader ts-node/esm scripts/checks/check-services.ts",
    "check:demo-ui": "pnpm exec tsx scripts/checks/check-demo-ui.ts",
    "test:postgres-ollama": "node --loader ts-node/esm scripts/checks/test-postgres-ollama.ts",
    "observe": "node --loader ts-node/esm scripts/checks/observer.ts",
    "observability": "docker compose up -d otel-collector prometheus grafana",
    "feed": "node --loader ts-node/esm src/feed.ts",
    "build:client": "pnpm --filter @sgrs/kernel-client build",
    "ensure-bucket": "node --loader ts-node/esm scripts/ops/ensure-bucket.ts",
    "ensure-schema": "node --loader ts-node/esm scripts/ops/ensure-schema.ts",
    "ensure-stream": "node --loader ts-node/esm scripts/ops/ensure-stream.ts",
    "ensure-pull-consumers": "node --loader ts-node/esm scripts/ops/ensure-pull-consumers.ts",
    "reset-e2e": "node --loader ts-node/esm scripts/ops/reset-e2e.ts",
    "reset-telemetry": "bash scripts/ops/reset-telemetry.sh",
    "reset-all": "RESET_TELEMETRY=1 node --loader ts-node/esm scripts/ops/reset-e2e.ts",
    "reinit:scenario-scopes": "node --loader ts-node/esm scripts/ops/reinit-scenario-scopes.ts",
    "seed:basic-example": "node --loader ts-node/esm scripts/demo/seed-basic-example.ts",
    "db-size": "node --loader ts-node/esm scripts/ops/db-size.ts",
    "bootstrap-once": "node --loader ts-node/esm scripts/ops/bootstrap-once.ts",
    "build:rust": "cd sgrs-core && pnpm exec napi build --release --platform",
    "build:rust:debug": "cd sgrs-core && pnpm exec napi build --platform",
    "benchmark:sgrs": "npx tsx scripts/benchmarks/benchmark-sgrs-load.ts",
    "test:dashboard:smoke": "pnpm exec tsx scripts/checks/test-dashboard-smoke.ts",
    "test:dashboard:regression": "pnpm exec tsx scripts/checks/test-dashboard-regression.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src test --max-warnings 80",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "demo:open": "bash scripts/demo/open-demo.sh",
    "exp:e19": "pnpm dlx tsx scripts/experiments/exp-e19-extract-loss.ts",
    "exp:e20": "pnpm dlx tsx scripts/experiments/exp-e20-escalation-necessity.ts",
    "exp:model-evals": "npx tsx scripts/experiments/model-qualification-hypersphere.ts",
    "p0:refresh-onboarding-policy": "npx tsx scripts/ops/p0-refresh-onboarding-policy.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^1.0.22",
    "@aws-sdk/client-s3": "^3.993.0",
    "@langchain/core": "^1.1.38",
    "@langchain/langgraph": "^1.2.6",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.1",
    "@mastra/core": "^1.50.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/instrumentation-http": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@symbolica/agentica": "^0.4.1",
    "dotenv": "^16.4.5",
    "jose": "^6.1.3",
    "mammoth": "^1.12.0",
    "nats": "^2.29.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "sgrs-core": "file:sgrs-core",
    "simple-statistics": "^7.8.8",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "exceljs": "^4.4.0",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.6"
  }
}
